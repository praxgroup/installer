{
  "name": "prax-installer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Installe et configure la base Prax sur Windows, Linux, Pterodactyl et Docker",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
