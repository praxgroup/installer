    "setup": "node tools/setup.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
